# SocietySync Environment Configuration
# Copy this file to .env and configure if you wish to enable live Google Gemini AI capabilities.
# If no key is provided, SocietySync automatically uses its built-in rule-based AI fallback.

# Port for the Express AI Proxy Server
PORT=5000

# Google Gemini API Key (Optional: get from https://aistudio.google.com/)
# NEVER commit your real .env file with secrets to Git.
GEMINI_API_KEY=
